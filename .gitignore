# Portable AI Coding Workspace - .gitignore

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/

# WSL
.wslconfig

# QEMU / VM disks (too large for Git)
VMs/**/*.qcow2
VMs/**/*.vdi
VMs/**/*.vmdk
*.qcow2
*.vdi
*.vmdk

# ISO files
ISO/*.iso
*.iso

# Temporary files
temp/
tmp/
*.tmp
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS (if VM files ever get created)
.DS_Store
*.dmg

# Docker
.docker/

# Logs
Workspace/Agent-Logs/*.log
Workspace/Outputs/*
!Workspace/Outputs/.gitkeep

# Secrets
*.env
*.secret
*.key
credentials.json
